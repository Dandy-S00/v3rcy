MYSQL_DATABASE=v3rya
MYSQL_USER=v3rya_app
# Keep MYSQL_PASSWORD URL-safe for the generated DATABASE_URL value. Avoid @, :, /, ?, #, %, and spaces.
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

APP_DOMAIN=app.example.com
TRAEFIK_NETWORK=traefik
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

JWT_SECRET=replace-with-a-long-random-secret
VITE_APP_ID=replace-with-your-public-app-id
VITE_OAUTH_PORTAL_URL=https://your-oauth-provider.example.com
OAUTH_SERVER_URL=https://your-oauth-provider.example.com

# Required only for features that use the shared service backend.
SERVICE_API_URL=
SERVICE_API_KEY=

# Optional map proxy configuration.
VITE_MAPS_API_URL=
VITE_MAPS_API_KEY=